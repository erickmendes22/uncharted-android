// g2-arm64: Uncharted 1's GPU skinning compute shader (cs 8f067540) for a batch of its
// dispatches at once (vk_skin_batch.cpp). The game dispatches it ~750 times a frame for a few
// hundred vertices each: on the GPU those ran one after another, each a compute state change for
// one workgroup. Here one workgroup of 64 invocations skins 64 vertices of one dispatch (a
// "job"); the job's buffers come by device address from the job table.
//
// The arithmetic is the translated guest shader's operation for operation, the order of the
// multiplies and adds included. Loads outside a buffer's bound range read zero and stores there
// are dropped, as robust buffer access does for the descriptors of the translated shader.
//
// Guest buffers of a job (the shader's V# order):
//   0  per vertex: influence count, byte offset of its first influence in buffer 4
//   1  position, float3
//   2  normal, half4
//   3  tangent, half4 (w: handedness)
//   4  influences: matrix index (bits 22..31), weight (bits 0..21, of 4194303)
//   5  bone matrices, 3x4 rows
//   6  out: position float3, 28-byte vertices
//   7  out: normal half4, 28-byte vertices (the same vertices, 12 bytes in)
//   8  out: tangent half4, 28-byte vertices (20 bytes in)
#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_spirv_intrinsics : require

// As the translated shader: 32-bit denormals flushed, signed zeros, infinities and NaNs kept.
spirv_execution_mode(capabilities = [4465], 4460, 32); // DenormFlushToZero
spirv_execution_mode(capabilities = [4466], 4461, 32); // SignedZeroInfNanPreserve

layout(local_size_x = 64) in;

layout(buffer_reference, std430, buffer_reference_align = 4) buffer Dword {
    uint value;
};

struct Job {
    uint64_t address[12]; // guest buffers 0..8 (0: none); the job layout of skin_mv_batch.comp
    uint size[12];        // their bound bytes
    uint count;           // vertices: min(the guest's vertex count, its invocations)
    uint first_group;     // the job's first workgroup in this dispatch
    uint scale;           // unused here
    uint pad;
};

layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer JobTable {
    Job jobs[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer GroupTable {
    uint job_of_group[];
};

layout(push_constant) uniform Push {
    JobTable job_table;
    GroupTable group_table;
    uint num_groups;
} push;

uint Load(uint64_t base, uint size, uint dword) {
    if (dword >= (size >> 2u)) {
        return 0u;
    }
    return Dword(base + uint64_t(dword) * 4ul).value;
}

void Store(uint64_t base, uint size, uint dword, uint value) {
    if (dword >= (size >> 2u)) {
        return;
    }
    Dword(base + uint64_t(dword) * 4ul).value = value;
}

float LoadF(uint64_t base, uint size, uint dword) {
    return uintBitsToFloat(Load(base, size, dword));
}

// The workgroup's output vertices, 7 dwords each, for the row stores.
shared uint rows_out[64 * 7];

void main() {
    const uint group = gl_WorkGroupID.x;
    if (group >= push.num_groups) {
        return;
    }
    const uint job_index = push.group_table.job_of_group[group];
    const Job job = push.job_table.jobs[job_index];
    const uint local = gl_LocalInvocationID.x;
    const uint vertex = (group - job.first_group) * 64u + local;
    const uint64_t a0 = job.address[0], a1 = job.address[1], a2 = job.address[2];
    const uint64_t a3 = job.address[3], a4 = job.address[4], a5 = job.address[5];
    const uint64_t a6 = job.address[6], a7 = job.address[7], a8 = job.address[8];
    const uint s0 = job.size[0], s1 = job.size[1], s2 = job.size[2], s3 = job.size[3];
    const uint s4 = job.size[4], s5 = job.size[5], s6 = job.size[6], s7 = job.size[7];
    const uint s8 = job.size[8];
    // g2-arm64: when the three output V#s interleave (the normal at +12, the tangent at +20, the
    // same size: stride times records, as in U1 and U2), a vertex's outputs are 7 consecutive
    // dwords of buffer 6, and the workgroup stores its vertices through shared memory as whole
    // rows: the per-field stores of 28-byte vertices touched 28 cache lines each (the batch
    // takes ~19% less time this way). On that path every lane takes part (the barrier): a lane
    // past the job's count computes its last vertex and stores nothing. The stored values and
    // the dropped out-of-range dwords are the same: with equal sizes a field's own bound and
    // buffer 6's agree for every vertex.
    const bool rows = a7 == a6 + 12ul && a8 == a6 + 20ul && s7 == s6 && s8 == s6;
    if (!rows && !(job.count > vertex)) {
        return;
    }
    const uint gid = rows ? min(vertex, job.count - 1u) : vertex;

    const uint i2 = gid * 2u;
    const uint influences = Load(a0, s0, i2);
    const uint first_offset = Load(a0, s0, i2 + 1u);
    const uint i3 = gid * 3u;
    const float px = LoadF(a1, s1, i3);
    const float py = LoadF(a1, s1, i3 + 1u);
    const float pz = LoadF(a1, s1, i3 + 2u);
    const vec2 n01 = unpackHalf2x16(Load(a2, s2, i2));
    const vec2 n23 = unpackHalf2x16(Load(a2, s2, i2 + 1u));
    const float nx = n01.x, ny = n01.y, nz = n23.x;
    const vec2 t01 = unpackHalf2x16(Load(a3, s3, i2));
    const vec2 t23 = unpackHalf2x16(Load(a3, s3, i2 + 1u));
    const float tx = t01.x, ty = t01.y, tz = t23.x, tw = t23.y;

    // The first influence's matrix: the position it gives is the base the others add to.
    const uint first = Load(a4, s4, first_offset >> 2u);
    const uint m0 = (first >> 22u) * 48u;
    const uint q0 = m0 >> 2u, q1 = (m0 + 16u) >> 2u, q2 = (m0 + 32u) >> 2u;
    const float b00 = LoadF(a5, s5, q0), b01 = LoadF(a5, s5, q0 + 1u);
    const float b02 = LoadF(a5, s5, q0 + 2u), b03 = LoadF(a5, s5, q0 + 3u);
    const float b10 = LoadF(a5, s5, q1), b11 = LoadF(a5, s5, q1 + 1u);
    const float b12 = LoadF(a5, s5, q1 + 2u), b13 = LoadF(a5, s5, q1 + 3u);
    const float b20 = LoadF(a5, s5, q2), b21 = LoadF(a5, s5, q2 + 1u);
    const float b22 = LoadF(a5, s5, q2 + 2u), b23 = LoadF(a5, s5, q2 + 3u);
    const float p0x = ((b00 * px + b03) + py * b01) + b02 * pz;
    const float p0y = ((b10 * px + b13) + b11 * py) + pz * b12;
    const float p0z = ((px * b20 + b23) + py * b21) + b22 * pz;

    float dpx = 0.0, dpy = 0.0, dpz = 0.0;
    float atx = 0.0, aty = 0.0, atz = 0.0;
    float anx = 0.0, any_ = 0.0, anz = 0.0;
    const float weight_scale = uintBitsToFloat(0x34800002u); // 1 / 4194303
    uint offset = first_offset;
    for (uint i = 0u; i < influences; ++i) {
        const uint packed = Load(a4, s4, offset >> 2u);
        offset += 4u;
        const uint m = (packed >> 22u) * 48u;
        const uint r0 = m >> 2u, r1 = (m + 16u) >> 2u, r2 = (m + 32u) >> 2u;
        const float c00 = LoadF(a5, s5, r0), c01 = LoadF(a5, s5, r0 + 1u);
        const float c02 = LoadF(a5, s5, r0 + 2u), c03 = LoadF(a5, s5, r0 + 3u);
        const float c10 = LoadF(a5, s5, r1), c11 = LoadF(a5, s5, r1 + 1u);
        const float c12 = LoadF(a5, s5, r1 + 2u), c13 = LoadF(a5, s5, r1 + 3u);
        const float weight = weight_scale * float(packed & 0x3FFFFFu);
        const float c20 = LoadF(a5, s5, r2), c21 = LoadF(a5, s5, r2 + 1u);
        const float c22 = LoadF(a5, s5, r2 + 2u), c23 = LoadF(a5, s5, r2 + 3u);
        const float qx = ((px * c00 + c03) + c01 * py) + pz * c02;
        const float qy = ((px * c10 + c13) + c11 * py) + pz * c12;
        const float qz = ((px * c20 + c23) + c21 * py) + pz * c22;
        const float ex = qx - p0x, ey = qy - p0y, ez = qz - p0z;
        const float rnx = (ny * c01 + c00 * nx) + nz * c02;
        const float rtx = (c01 * ty + c00 * tx) + tz * c02;
        dpx = ex * weight + dpx;
        const float rty = (ty * c11 + c10 * tx) + tz * c12;
        const float rny = (ny * c11 + c10 * nx) + nz * c12;
        dpy = ey * weight + dpy;
        dpz = ez * weight + dpz;
        const float rtz = (ty * c21 + c20 * tx) + tz * c22;
        const float rnz = (ny * c21 + c20 * nx) + nz * c22;
        atx = rtx * weight + atx;
        aty = rty * weight + aty;
        atz = rtz * weight + atz;
        anx = rnx * weight + anx;
        any_ = rny * weight + any_;
        anz = rnz * weight + anz;
    }

    // Normal: the weighted rotation, normalized. Tangent: made orthogonal to it
    // ((n x t) x n), normalized, handedness kept.
    const float len2 = (any_ * any_ + anx * anx) + anz * anz;
    const float inv = inversesqrt(len2);
    const float nnz = inv * anz;
    const float nnx = inv * anx;
    const float nny = inv * any_;
    const float c1 = nnx * -atz + atx * nnz;
    const float c2 = nny * -atx + aty * nnx;
    const float bx = nny * -c2 + c1 * nnz;
    const float c0 = nnz * -aty + atz * nny;
    const float by = nnz * -c0 + c2 * nnx;
    const float bz = nnx * -c1 + c0 * nny;
    const float lb2 = (by * by + bx * bx) + bz * bz;
    const float invb = inversesqrt(lb2);
    const float ox = dpx + p0x, oy = dpy + p0y, oz = dpz + p0z;

    const uint o = gid * 7u;
    if (rows) {
        const uint w = local * 7u;
        rows_out[w] = floatBitsToUint(ox);
        rows_out[w + 1u] = floatBitsToUint(oy);
        rows_out[w + 2u] = floatBitsToUint(oz);
        rows_out[w + 3u] = packHalf2x16(vec2(nnx, nny));
        rows_out[w + 4u] = packHalf2x16(vec2(nnz, 0.0));
        rows_out[w + 5u] = packHalf2x16(vec2(invb * bx, invb * by));
        rows_out[w + 6u] = packHalf2x16(vec2(invb * bz, tw));
        memoryBarrierShared();
        barrier();
        const uint first = (group - job.first_group) * (64u * 7u);
        const uint end = min(job.count * 7u, s6 >> 2u);
        for (uint k = 0u; k < 7u; ++k) {
            const uint i = local + k * 64u;
            if (first + i < end) {
                Dword(a6 + uint64_t(first + i) * 4ul).value = rows_out[i];
            }
        }
        return;
    }
    Store(a6, s6, o, floatBitsToUint(ox));
    Store(a6, s6, o + 1u, floatBitsToUint(oy));
    Store(a6, s6, o + 2u, floatBitsToUint(oz));
    Store(a7, s7, o, packHalf2x16(vec2(nnx, nny)));
    Store(a7, s7, o + 1u, packHalf2x16(vec2(nnz, 0.0)));
    Store(a8, s8, o, packHalf2x16(vec2(invb * bx, invb * by)));
    Store(a8, s8, o + 1u, packHalf2x16(vec2(invb * bz, tw)));
}
