 }
 
 static void kgsl_bo_finish(struct tu_device *dev, struct tu_bo *bo);
@@ -709,11 +715,47 @@ struct kgsl_syncobj
    enum kgsl_syncobj_state state;
 
    struct tu_queue *queue;
+   uint32_t context_id; /* KGSL context of the timestamp (the queue may have moved on) */
    uint32_t timestamp;
 
    int fd;
 };
 
+/* uncharted-android: KGSL context recovery (TU_KGSL_RECOVER, on by default). After more than 3
+ * GPU faults within 2 s KGSL invalidates the context ("gpu fault threshold exceeded") and every
+ * later submission to it fails, which Vulkan can only report as a lost device. The A735 CP
+ * (Retroid Pocket G2) sometimes misreads command streams in such bursts, so the queue moves to a
+ * new KGSL context instead: the work KGSL dropped is lost (a bad frame) and the game goes on.
+ * Timestamps of the old context count as signaled. TU_KGSL_RECOVER=0 keeps the lost device.
+ */
+static bool
+kgsl_recover_enabled(void)
+{
+   static int v = -1;
+   if (v < 0) {
+      const char *env = getenv("TU_KGSL_RECOVER");
+      v = !(env && env[0] == '0');
+   }
+   return v;
+}
+
+static bool
+kgsl_ctx_retired(const struct tu_queue *queue, uint32_t context_id)
+{
+   uint32_t n = p_atomic_read(&queue->kgsl_retired_count);
+   for (uint32_t i = 0; i < n; i++) {
+      if (queue->kgsl_retired[i] == context_id)
+         return true;
+   }
+   return false;
+}
+
+static inline bool
+kgsl_syncobj_ts_retired(const struct kgsl_syncobj *s)
+{
+   return s->state == KGSL_SYNCOBJ_STATE_TS && kgsl_ctx_retired(s->queue, s->context_id);
+}
+
 static void
 kgsl_syncobj_init(struct kgsl_syncobj *s, bool signaled)
 {
@@ -755,13 +797,13 @@ kgsl_syncobj_dup(struct kgsl_syncobj *s)
 }
 
 static int
-timestamp_to_fd(struct tu_queue *queue, uint32_t timestamp)
+timestamp_to_fd(struct tu_queue *queue, uint32_t context_id, uint32_t timestamp)
 {
    int fd;
    struct kgsl_timestamp_event event = {
       .type = KGSL_TIMESTAMP_EVENT_FENCE,
       .timestamp = timestamp,
-      .context_id = queue->msm_queue_id,
+      .context_id = context_id,
       .priv = &fd,
       .len = sizeof(fd),
    };
@@ -777,7 +819,9 @@ static int
 kgsl_syncobj_ts_to_fd(const struct kgsl_syncobj *syncobj)
 {
    assert(syncobj->state == KGSL_SYNCOBJ_STATE_TS);
-   return timestamp_to_fd(syncobj->queue, syncobj->timestamp);
+   if (kgsl_syncobj_ts_retired(syncobj))
+      return -1; /* signaled */
+   return timestamp_to_fd(syncobj->queue, syncobj->context_id, syncobj->timestamp);
 }
 
 /* return true if timestamp a is greater (more recent) then b
@@ -861,6 +905,11 @@ wait_timestamp_safe(int fd,
 
          wait.timeout = timeout_ms;
       } else if (ret == -1) {
+         /* uncharted-android: an invalidated context (EDEADLK) retires nothing any more and
+          * KGSL dropped its queued work: its timestamps count as signaled.
+          */
+         if (errno == EDEADLK)
+            return VK_SUCCESS;
          assert(errno == ETIMEDOUT);
          return VK_TIMEOUT;
       } else {
@@ -924,7 +973,9 @@ kgsl_syncobj_wait(struct tu_device *device,
       return VK_TIMEOUT;
 
    case KGSL_SYNCOBJ_STATE_TS: {
-      return wait_timestamp_safe(device->fd, s->queue->msm_queue_id,
+      if (kgsl_syncobj_ts_retired(s))
+         return VK_SUCCESS;
