 src/freedreno/vulkan/tu_knl_kgsl.cc | 292 ++++++++++++++++++++++++----
 src/freedreno/vulkan/tu_queue.cc    |   2 +
 src/freedreno/vulkan/tu_queue.h     |   7 +
 3 files changed, 263 insertions(+), 38 deletions(-)

diff --git a/src/freedreno/vulkan/tu_knl_kgsl.cc b/src/freedreno/vulkan/tu_knl_kgsl.cc
index f316e04bcf0..852403ddc71 100644
--- a/src/freedreno/vulkan/tu_knl_kgsl.cc
+++ b/src/freedreno/vulkan/tu_knl_kgsl.cc
@@ -82,6 +82,12 @@ kgsl_submitqueue_close(struct tu_device *dev, struct tu_queue *queue)
    };
 
    safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_DRAWCTXT_DESTROY, &req);
+
+   for (uint32_t i = 0; i < queue->kgsl_retired_count; i++) {
+      req.drawctxt_id = queue->kgsl_retired[i];
+      safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_DRAWCTXT_DESTROY, &req);
