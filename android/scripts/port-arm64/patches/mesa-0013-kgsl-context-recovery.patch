@@ -629,6 +629,8 @@ tu_queue_init(struct tu_device *device,
    queue->fence = -1;
    queue->priority = -1;
    queue->msm_queue_id = 0;
+   queue->kgsl_retired_count = 0;
+   queue->kgsl_ctx_bad = 0;
 
    if (shared_queue) {
       /* Emulated queue: submissions are redirected to the real queue by
diff --git a/src/freedreno/vulkan/tu_queue.h b/src/freedreno/vulkan/tu_queue.h
index 48f2ea9821e..1d9789819c0 100644
--- a/src/freedreno/vulkan/tu_queue.h
+++ b/src/freedreno/vulkan/tu_queue.h
@@ -36,6 +36,13 @@ struct tu_queue
    unsigned render_pass_idx;
 
    int fence;           /* timestamp/fence of the last queue submission */
+
+   /* uncharted-android (KGSL): contexts this queue left after KGSL invalidated them (their
+    * timestamps count as signaled), destroyed with the queue; kgsl_ctx_bad: check_status saw a
+    * guilty reset, the next submission moves to a new context. */
+   uint32_t kgsl_retired[64];
+   uint32_t kgsl_retired_count;
+   uint32_t kgsl_ctx_bad;
 };
 VK_DEFINE_HANDLE_CASTS(tu_queue, vk.base, VkQueue, VK_OBJECT_TYPE_QUEUE)
 
