From e7ad3b9a116577d985768287daeace8b1b2c9239 Mon Sep 17 00:00:00 2001
From: revvv991 <345025393+revvv991@users.noreply.github.com>
Subject: [PATCH] turnip/kgsl: diagnostics: TU_BO_LOG=1 prints BO allocations
 and frees, TU_KGSL_CTX_FLAGS adds context flags

TU_BO_LOG=1 (with TU_DEBUG=bos for the names) prints every BO allocation and free to stderr with
its GPU address, size and CLOCK_MONOTONIC time, the kernel log's clock: the ib1/ib2 addresses of a
KGSL fault report can be matched to the BO they were in (cmd, draw, pipeline_suballoc, ...).
TU_KGSL_CTX_FLAGS=<hex> ORs flags into the KGSL draw context: the preemption style, the priority,
the context type.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/freedreno/vulkan/tu_knl_kgsl.cc | 41 +++++++++++++++++++++++++++++
 1 file changed, 41 insertions(+)

diff --git a/src/freedreno/vulkan/tu_knl_kgsl.cc b/src/freedreno/vulkan/tu_knl_kgsl.cc
index 871a74419f2..f316e04bcf0 100644
--- a/src/freedreno/vulkan/tu_knl_kgsl.cc
+++ b/src/freedreno/vulkan/tu_knl_kgsl.cc
@@ -56,6 +56,15 @@ kgsl_submitqueue_new(struct tu_device *dev, struct tu_queue *queue)
               KGSL_CONTEXT_PREAMBLE,
    };
 
+   /* uncharted-g2 diagnosis: TU_KGSL_CTX_FLAGS=<hex> adds KGSL context flags, e.g. the
+    * preemption style (KGSL_CONTEXT_PREEMPT_STYLE_RINGBUFFER << 25 = 0x02000000: preempted
+    * only between submissions), the priority (<< 12) or the type (VK = 5 << 20).
+    */
+   if (const char *extra = getenv("TU_KGSL_CTX_FLAGS")) {
+      req.flags |= (uint32_t) strtoul(extra, NULL, 0);
+      fprintf(stderr, "tu/kgsl: context flags 0x%08x\n", req.flags);
+   }
+
    int ret = safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_DRAWCTXT_CREATE, &req);
    if (ret)
       return ret;
@@ -77,6 +86,34 @@ kgsl_submitqueue_close(struct tu_device *dev, struct tu_queue *queue)
 
 static void kgsl_bo_finish(struct tu_device *dev, struct tu_bo *bo);
 
+/* uncharted-g2 diagnosis: TU_BO_LOG=1 prints every BO allocation and free (name, GPU address,
+ * size) to stderr, with CLOCK_MONOTONIC seconds (the kernel log's clock), so that an address in a
+ * KGSL fault report (ib1/ib2) can be matched to the BO it was in at that time.
+ */
+static bool
+tu_bo_log_enabled(void)
+{
+   static int enabled = -1;
+   if (enabled < 0) {
+      const char *env = getenv("TU_BO_LOG");
+      enabled = env && env[0] == '1';
+   }
+   return enabled;
+}
+
+static void
+tu_bo_log(const char *what, const struct tu_bo *bo)
+{
+   if (!tu_bo_log_enabled())
+      return;
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   fprintf(stderr, "tu-bo %llu.%06ld %s id %u iova 0x%llx size 0x%llx %s\n",
+           (unsigned long long) ts.tv_sec, ts.tv_nsec / 1000, what, bo->gem_handle,
+           (unsigned long long) bo->iova, (unsigned long long) bo->size,
+           bo->name ? bo->name : "?");
+}
+
 static VkResult
 bo_init_new_dmaheap(struct tu_device *dev, struct tu_bo **out_bo, uint64_t size,
                 enum tu_bo_alloc_flags flags)
@@ -319,6 +356,7 @@ kgsl_bo_init(struct tu_device *dev,
    };
 
    tu_dump_bo_init(dev, bo);
+   tu_bo_log("alloc", bo);
 
    VkResult result = VK_SUCCESS;
 
@@ -387,6 +425,7 @@ kgsl_bo_init_dmabuf(struct tu_device *dev,
       .refcnt = 1,
       .shared_fd = os_dupfd_cloexec(fd),
    };
+   tu_bo_log("dmabuf", bo);
 
    struct stat st;
    if (fstat(fd, &st) == 0)
@@ -446,6 +485,7 @@ kgsl_bo_finish(struct tu_device *dev, struct tu_bo *bo)
    if (!p_atomic_dec_zero(&bo->refcnt))
       return;
 
+   tu_bo_log("free", bo);
    tu_debug_bos_del(dev, bo);
    tu_dump_bo_del(dev, bo);
 
@@ -534,6 +574,7 @@ kgsl_sparse_vma_init(struct tu_device *dev,
 
       bo->iova = info.gpuaddr;
    }
+   tu_bo_log("vma", bo);
 
    out_vma->kgsl.virtual_bo = bo;
    *out_iova = bo->iova;
-- 
